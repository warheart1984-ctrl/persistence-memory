JARVIS_HOST=0.0.0.0
JARVIS_PORT=8001
JARVIS_STORE_PATH=data/jarvis-store.json
JARVIS_EMR_DYNAMICS_PATH=data/emr-dynamics.json
JARVIS_CORS_ORIGINS=*

# Local dev: leave unset for open recall. Render/public: required.
# EMR_RECALL_API_KEY=

# Public deploy: disable ledger writes (recall-only).
# JARVIS_MEMORY_WRITE_ENABLED=false

# MCP write tools (emr_remember / emr_upsert). Default false on public deploy.
# Local dev: copy to .env.local or export before uvicorn (stdio MCP proxy does NOT set this).
JARVIS_MCP_WRITE_ENABLED=true

# Optional: force source_agent for all MCP writes (ignore model-supplied agent).
# JARVIS_MCP_FIXED_SOURCE_AGENT=user-requested-mcp

# When EMR_RECALL_API_KEY is set, require it for GET /api/jarvis/memory/* too.
# JARVIS_PROTECT_LEDGER_READ=true

# Remote MCP client pointing at Render:
# JARVIS_MEMORYBOARD_URL=https://your-service.onrender.com
# EMR_RECALL_API_KEY=...

# Optional HTTPS base for search/fetch citation URLs (default ledger://{id})
# JARVIS_LEDGER_CITATION_BASE=https://your-service.onrender.com/api/jarvis/memory
