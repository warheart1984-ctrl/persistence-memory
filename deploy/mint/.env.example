# Copy to deploy/mint/.env (gitignored). Plain KEY=VALUE lines, no quotes: read by docker compose, the scripts
# and the systemd units alike. No secrets here (those live in secrets/).

# Host port of the app, bound to 127.0.0.1 only. 8001 is taken by the older persistence-memory service on the
# Mint box, so the new stack uses 8011.
JARVIS_APP_PORT=8011

# Where backups, logs and state live (default: ~/jarvis-ledger)
# JARVIS_HOME=/home/jon/jarvis-ledger

# Watchdog thresholds (seconds / percent); the defaults suit hourly backups
# BACKUP_MAX_AGE=7800
# OFFSITE_MAX_AGE=172800
# DRILL_MAX_AGE=864000
# DISK_MIN_FREE_PCT=10

# Signatures (schema v7): off | warn | require. warn is the default (and what the app and the verifier do when this is unset):
# an unsigned block or receipt is a warning, an invalid attestation is always a problem. Switch to require only after the signer
# has run in warn for 7 days without the watchdog complaining; require makes unsigned or invalid a failure and never reports
# success without a trust root. docs/SIGNING_RUNBOOK.md.
# JARVIS_SIGNATURES=warn
