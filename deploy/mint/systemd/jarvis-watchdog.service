[Unit]
Description=Jarvis ledger: health and staleness watchdog
Documentation=file://@DEPLOY_DIR@/README.md

[Service]
Type=oneshot
Environment=JARVIS_HOME=@JARVIS_HOME@
# optional tuning (JARVIS_APP_PORT, BACKUP_MAX_AGE, NOTIFY_EVERY_SECONDS, ...); the dash makes the file optional
EnvironmentFile=-@DEPLOY_DIR@/.env
EnvironmentFile=-@JARVIS_HOME@/systemd.env
ExecStart=@DEPLOY_DIR@/bin/watchdog.sh
TimeoutStartSec=2min
NoNewPrivileges=true
PrivateTmp=true
