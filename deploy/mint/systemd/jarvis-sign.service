[Unit]
Description=Jarvis ledger: sign new sealed blocks and a checkpoint (the private signing key never leaves this host)
Documentation=file://@DEPLOY_DIR@/README.md

[Service]
Type=oneshot
Environment=JARVIS_HOME=@JARVIS_HOME@
# optional tuning (JARVIS_APP_PORT, ...); the dash makes the file optional
EnvironmentFile=-@DEPLOY_DIR@/.env
EnvironmentFile=-@JARVIS_HOME@/systemd.env
ExecStart=@DEPLOY_DIR@/bin/attest.sh sign
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
